# nginx 配置模板：${BACKEND_ORIGIN} 启动时由 envsubst 注入。
#
# 反代路径必须与 vite.config.ts 的 dev proxy 一致（/api /v1 /pg）——
# 后端 session cookie 是 SameSite=Strict，前后端必须同源，
# 所以生产环境同样由 nginx 做同源反代，绝不能让浏览器跨域直连后端。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 静态资源：带 hash 的文件名可以永久缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # WebSocket：工单与在线客服的长连接。
    #
    # 正则 location 优先于前缀 location，所以只有 ws 路径走这里，
    # 其余 /api/ 请求仍走下面那条普通反代。
    # Connection 硬写 "upgrade" 只在这个 location 内生效，不会破坏
    # 普通 HTTP 的 keepalive（标准做法是在 http 块加 map $http_upgrade，
    # 而本文件是 server 块级片段，map 没有落脚处）。
    location ~ ^/api/(tickets|support)/.*/ws$ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # 长连接不能被读超时掉。服务端每 30s 一次 ping，
        # 1 小时的余量足够覆盖任何正常空闲。
        proxy_read_timeout 3600s;
    }

    # 后端反代：保留原始 Host（对应 dev proxy 的 changeOrigin:false）
    location /api/ {
        # 请求体上限。nginx 默认 1m，超过就在到达后端前被 413 掉，
        # 前端看不到真正的失败原因。留 5m 余量给请求体较大的接口。
        client_max_body_size 5m;
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE / 流式响应不能缓冲
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /v1/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # LLM 流式输出：必须关缓冲，否则 SSE 会整段卡住再一次性吐出
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location /pg/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /pg 的聊天接口走 SSE 流式，同样必须关缓冲并拉长读超时
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # SPA 回退：任意路径都回 index.html，交给 vue-router
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
